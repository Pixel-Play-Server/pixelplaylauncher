<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Pixel Play Launcher" Language="1033" Version="4.0.0" Manufacturer="PixelPlay" UpgradeCode="PUT-UPGRADE-GUID-HERE">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"/>
    <MediaTemplate/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Pixel Play Launcher" />
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="Pixel Play Launcher" Level="1">
      <ComponentGroupRef Id="ProductComponents"/>
    </Feature>
  </Product>
</Wix>
